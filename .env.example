# Docker Compose가 프로젝트 루트에서 자동으로 읽는 로컬 개발 설정입니다.
# 이 파일을 .env로 복사하고 실제 비밀값은 .env에만 입력하세요.

APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8080

# ADR-0040 §6: host watch가 읽는 컨테이너 내부 loopback ops health 리스너.
# 비어 있으면 비활성이며 production Compose만 127.0.0.1:9090을 설정합니다.
OPS_INTERNAL_HTTP_ADDR=

# Phase 6 runtime resource policy. 초 단위 timeout은 0이나 음수를 허용하지 않으며,
# migration advisory connection과 migration transaction이 동시에 필요하므로 max open은
# 2 이상이며, max idle은 max open보다 클 수 없습니다.
DB_MAX_OPEN_CONNECTIONS=40
DB_MAX_IDLE_CONNECTIONS=10
DB_CONNECTION_MAX_IDLE_SECONDS=300
DB_CONNECTION_MAX_LIFETIME_SECONDS=1800
DB_ACQUIRE_TIMEOUT_SECONDS=2
DB_MIGRATION_LOCK_TIMEOUT_SECONDS=120
DB_INTERACTIVE_QUERY_TIMEOUT_SECONDS=3
DB_INTERACTIVE_TRANSACTION_TIMEOUT_SECONDS=8
DB_INTERACTIVE_LOCK_TIMEOUT_SECONDS=1
DB_WORKER_QUERY_TIMEOUT_SECONDS=5
DB_WORKER_TRANSACTION_TIMEOUT_SECONDS=15
DB_WORKER_LOCK_TIMEOUT_SECONDS=1
DB_ADMIN_QUERY_TIMEOUT_SECONDS=60
DB_ADMIN_TRANSACTION_TIMEOUT_SECONDS=120
DB_ADMIN_LOCK_TIMEOUT_SECONDS=5
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_KEEP_ALIVE_SECONDS=30
HTTP_TLS_HANDSHAKE_TIMEOUT_SECONDS=5
HTTP_RESPONSE_HEADER_TIMEOUT_SECONDS=20
HTTP_EXPECT_CONTINUE_TIMEOUT_SECONDS=1
HTTP_IDLE_CONNECTION_TIMEOUT_SECONDS=90
HTTP_MAX_IDLE_CONNECTIONS=100
HTTP_MAX_IDLE_CONNECTIONS_PER_HOST=10
HTTP_MAX_CONNECTIONS_PER_HOST=20
# Public API in-flight handler 상한. 초과 요청은 대기하지 않고 retryable 503을 받습니다.
HTTP_MAX_CONCURRENT_REQUESTS=500
HTTP_REQUEST_TIMEOUT_SECONDS=10
EXTERNAL_FINALIZATION_TIMEOUT_SECONDS=3
GOOGLE_OIDC_TIMEOUT_SECONDS=15
SHOPIFY_UCP_TIMEOUT_SECONDS=15
MANAGED_MODEL_TIMEOUT_SECONDS=180
EVM_RPC_HTTP_TIMEOUT_SECONDS=15
MARKETING_BASE_URL=http://marketing.localhost:8080
MARKETING_ADMIN_EMAILS=admin@example.com,operator@example.com
# Wallet/Google/Agent OAuth attempt subject를 DB에 원문으로 저장하지 않기 위한
# HMAC secret입니다. 아래 값은 local development 전용입니다.
ACCOUNT_RATE_LIMIT_SECRET=local-account-rate-limit-secret
ACCOUNT_RATE_LIMIT_KEY_VERSION=1

# 일반 개발 중에는 true를 사용할 수 있습니다.
# 실제 Google smoke에서는 둘 다 false로 바꿔 개발용 로그인 경로를 제외하세요.
ALLOW_DEV_AUTH=true
VITE_ALLOW_DEV_AUTH_UI=true
# 일반 Compose에는 샘플 User가 자동 생성되지 않습니다. 전체 검수는
# scripts/local-review.sh가 전용 DB fixture와 이 값을 함께 구성합니다.
DEV_AUTH_DEFAULT_USER_ID=

# Google Auth Platform에서 만든 Web application client의 값입니다.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
MOBILE_AUTH_REDIRECT_URIS=vitlane://auth/callback

# Cross-Origin-Protection이 추가로 신뢰할 개발 origin에만 지정합니다.
# 이 값은 CORS를 켜지 않으므로 Web은 /api를 Server로 proxy해야 합니다.
# 단일 Docker 앱(http://localhost:8080)에서는 비워둡니다.
TRUSTED_BROWSER_ORIGIN=

# Shopify 공식 Global Catalog MCP의 read-only 상품 검색입니다. 실제 checkout/order
# 호출과 별개이며, live test를 명시적으로 수행할 때만 켭니다.
SHOPIFY_UCP_ENABLED=false
SHOPIFY_UCP_CATALOG_URL=https://catalog.shopify.com/api/ucp/mcp
SHOPIFY_UCP_AGENT_PROFILE_URL=https://shopify.dev/ucp/agent-profiles/2026-04-08/valid-with-capabilities.json
# Step 2 AgencyOrder. Production compose는 이를 true/shopify로 고정하고 Shopify
# credential을 필수화한다. `get_checkout`까지만 사용하며 actual Shop 구매는 후속
# 운영자 handoff다. secret 원문은 저장소나 배포 evidence에 남기지 않는다.
AGENCY_ORDER_ENABLED=false
AGENCY_ORDER_CHECKOUT_PROVIDER=stub
AGENCY_ORDER_BUYER_CONTACT_EMAIL=
SHOPIFY_DEV_CLIENT_ID=
SHOPIFY_DEV_CLIENT_SECRET=
# PayPal은 현재 Sandbox만 활성화한다. Live adapter credential은 미리 둘 수 있지만
# 아래 세 effect gate는 Live 전환 승인 전까지 반드시 false로 유지한다.
PAYPAL_SANDBOX_ENABLED=false
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_WEBHOOK_ID=
# local-review가 Sandbox binding을 만들 때만 쓰는 non-secret merchant ID다.
PAYPAL_SANDBOX_MERCHANT_ID=
LIVE_AGENCY_ORDER_ISSUE_ENABLED=false
PAYPAL_LIVE_CAPTURE_ENABLED=false
MANUAL_MERCHANT_EFFECT_ENABLED=false
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_WEBHOOK_ID=
PAYPAL_LIVE_MERCHANT_ID=
PAYPAL_LIVE_EMAIL=
# Curation의 canonical Catalog Research 경로다. production은 true와 live Shopify를
# 요구하고, local/test만 RESEARCH_CATALOG_PROVIDER=stub을 허용한다.
CURATION_CATALOG_RESEARCH_ENABLED=false
# Amazon US pilot; private adapter credential is server-only.
AMAZON_PRODUCT_SEARCH_ENABLED=false
# Local review only: stub reads the file and never calls the live provider.
AMAZON_PRODUCT_SEARCH_MODE=live
AMAZON_PRODUCT_SEARCH_STUB_FILE=
AMAZON_PRODUCT_SEARCH_API=
CURATION_CATALOG_RESEARCH_CALLS_PER_MINUTE=10
CURATION_CATALOG_RESEARCH_MAX_CONCURRENCY=16

# ADR-0032 ManagedRunner. Server 자체 기본값은 켜짐이지만 compose는 꺼짐으로
# 전달합니다. 모델 secret이 없는 환경이 compose의 침묵 때문에 기동 실패하는 것을
# 막기 위해서이며, 켜는 것은 secret과 함께 내리는 명시적 배포 결정입니다.
# secret이 없는 상태로 켜면 Server는 기동을 거절합니다.
MANAGED_RUNNER_ENABLED=false
MANAGED_RUNNER_MODEL_PROVIDER=openai
MANAGED_OPENAI_API_SECRET=
MANAGED_RUNNER_CONCURRENCY=10
# 일일 비용 하드 리밋(USD micros). admission은 하드 리밋보다 낮게 두어 진행 중인
# 작업이 리밋 안에서 정산을 마칠 여유를 남깁니다.
MANAGED_RUNNER_SERVER_DAILY_MICROS=10000000
MANAGED_RUNNER_SERVER_ADMISSION_MICROS=8000000
MANAGED_RUNNER_USER_DAILY_MICROS=100000
# 로컬 검수와 E2E 전용 결정적 카탈로그입니다. production에서는 기동을 거절합니다.
RESEARCH_CATALOG_PROVIDER=

# Phase 5는 기본 비활성입니다. reviewed ACTIVE manifest와 별도 signer key directory를
# 준비한 뒤 compose.phase5.yaml overlay와 함께 명시적으로 활성화하세요.
PHASE5_SETTLEMENT_ENABLED=false
PHASE5_OPERATOR_EMAILS=
SETTLEMENT_ENV=DISABLED
GIWA_CHAIN_ID=91342
GIWA_RPC_URL=
GIWA_PUBLIC_RPC_URL=
GIWA_EXPLORER_URL=
PHASE5_CONFIG_DIR=
ONCHAIN_MANIFEST_PATH=/run/vitlane/phase5/manifest.json
QUOTE_SIGNER_KEY_FILE=/run/vitlane/phase5/quote-signer.key
FINALIZER_KEY_FILE=/run/vitlane/phase5/finalizer.key
REFUNDER_KEY_FILE=/run/vitlane/phase5/refunder.key
KYC_ASSURANCE_MODE=MOCK_DOJANG_VERIFIED
PII_ENCRYPTION_KEY=
PII_KEY_VERSION=v1
# ADR-0040 §8 rotation: "v2:<base64>,v1:<base64>"로 여러 버전을 유지하면
# 재암호화 worker가 옛 행을 활성 버전으로 옮깁니다. 비우면 단일 키 모드.
PII_ENCRYPTION_KEYS=
PII_DELETION_GRACE_HOURS=24
PII_SNAPSHOT_RETENTION_DAYS=1825
# 운영자 민감 조작(PII reveal 등)의 재인증 창 (ADR-0040 §10)
OPERATOR_FRESH_AUTH_MINUTES=15
# MVP TestPhase에서는 APP_ENV=production + GIWA_TESTNET에서도 MockDojang을 허용합니다.
# domain lifecycle·audit·assurance는 동일하고 provider externalEffect만 SIMULATED입니다.
# DOJANG_TEST_FAUCET attestation은 KYC로 인정하지 않습니다.
DOJANG_SCROLL_ADDRESS=0xd5077b67dcb56caC8b270C7788FC3E6ee03F17B9
DOJANG_EAS_ADDRESS=0x4200000000000000000000000000000000000021
DOJANG_SCHEMA_UID=0x072d75e18b2be4f89a13a7147240477481c4b526d5795802acba59046b426e08
# 비우면 선택한 mode의 공식 검증값을 사용합니다. 배포 시 DojangAttesterBook
# 온체인 조회값과 대조한 뒤 pin을 변경합니다.
DOJANG_ATTESTER_ID=
DOJANG_ATTESTER_ADDRESS=
TVITUSD_ADDRESS=
FAUCET_ADDRESS=
SETTLEMENT_ADDRESS=
TEST_FEE=
REFUNDER_ADDRESS=
PAUSER_ADDRESS=
AMAZON_TEST_PRINCIPAL=
WALMART_TEST_PRINCIPAL=
SHOPIFY_TEST_PRINCIPAL=
GENERIC_WEB_TEST_PRINCIPAL=
AMAZON_TEST_REGISTRY_VERSION=1
WALMART_TEST_REGISTRY_VERSION=1
SHOPIFY_TEST_REGISTRY_VERSION=1
GENERIC_WEB_TEST_REGISTRY_VERSION=1
FAUCET_CLAIM_AMOUNT=1000000000
CHAIN_START_BLOCK=0

# Curation Step 2: KR product observations (external purchase only).
# Keys remain server-only. Optional OWN_WEB / SERP_GOOGLE start Off in operator controls.
KOREAN_PRODUCT_SEARCH_ENABLED=false
BROWSER_PRODUCT_SEARCH_ENABLED=false
BROWSER_BRIDGE_URL=http://127.0.0.1:8787
# Server↔browser bridge bearer; generate 32+ random bytes and never expose it to Web/RN.
BRIDGE_TOKEN=
# Local server-side discovery browser. The browser-fork checkout reads the same
# root .env through its symlink; use an installed Playwright channel here.
PLAYWRIGHT_CHANNEL=chrome
OPEN_WEB_NINJA_API_KEY=
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
SERP_API_KEY=
# Paid third-party Actor runs for Musinsa, 29CM and Gmarket. Empty means those
# routes stay unavailable. The USD cap is enforced by Vitlane before a run starts.
APIFY_API_TOKEN=
APIFY_MONTHLY_CAP_USD=5
# QUARANTINED: Vitlane has no ADPICK runtime adapter, provider ledger or canonical
# product resolver. Do not uncomment or put a key here until that boundary exists.
# ADPICK_API_KEY=

# Step 7: server-wide passive deal feeds (no per-subscriber searches).
BACKGROUND_RESEARCH_ENABLED=false
BACKGROUND_TELEGRAM_ENABLED=true
BACKGROUND_AMAZON_ENABLED=false
# Amazon background requires a positive daily cap; foreground keeps this quota reserve.
BACKGROUND_AMAZON_DAILY_CALLS=0
BACKGROUND_AMAZON_FOREGROUND_RESERVE=10

# Optional behavior analytics. Internal business SQL does not depend on this.
# disabled | debug (local only) | ga4 (production only; configure server-side credentials)
ANALYTICS_MODE=disabled
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
ANALYTICS_IDENTITY_KEY=
