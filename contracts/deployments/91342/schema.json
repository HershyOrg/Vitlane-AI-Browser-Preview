{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitlane.com/schemas/onchain-deployment.v1.json",
  "title": "Vitlane onchain deployment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "environment",
    "chainId",
    "status",
    "deployedAt",
    "sourceCommit",
    "sourceTreeHash",
    "sourceProvenance",
    "abiVersion",
    "compiler",
    "roles",
    "policies",
    "merchantRegistry",
    "configurationTransactions",
    "sourceVerification",
    "finality",
    "contracts"
  ],
  "properties": {
    "schemaVersion": { "const": "vitlane.onchain-deployment.v1" },
    "version": { "type": "string", "pattern": "^phase5-v[0-9]{3}$" },
    "environment": { "enum": ["TEST", "REAL"] },
    "chainId": { "const": 91342 },
    "status": { "enum": ["ACTIVE", "PAUSED", "REJECTED", "RETIRED", "PENDING"] },
    "deployedAt": { "type": "string", "format": "date-time" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sourceTreeHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sourceProvenance": {
      "enum": ["GIT_COMMIT", "VERIFIED_UNCOMMITTED_WORKTREE"]
    },
    "abiVersion": { "const": "v1" },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solc", "foundry", "optimizer", "bytecodeHash", "cborMetadata"],
      "properties": {
        "solc": { "const": "0.8.30+commit.73712a01" },
        "foundry": { "const": "1.7.1" },
        "optimizer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "runs"],
          "properties": {
            "enabled": { "const": true },
            "runs": { "const": 200 }
          }
        },
        "bytecodeHash": { "const": "none" },
        "cborMetadata": { "const": false }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployer",
        "admin",
        "pauser",
        "quoteSigner",
        "finalizer",
        "refunder",
        "feeRecipient"
      ],
      "properties": {
        "deployer": { "$ref": "#/$defs/address" },
        "admin": { "$ref": "#/$defs/address" },
        "pauser": { "$ref": "#/$defs/address" },
        "quoteSigner": { "$ref": "#/$defs/address" },
        "finalizer": { "$ref": "#/$defs/address" },
        "refunder": { "$ref": "#/$defs/address" },
        "feeRecipient": { "$ref": "#/$defs/address" }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenDecimals",
        "feeBps",
        "faucetClaimAmount",
        "faucetCooldownSeconds",
        "faucetDailyCap",
        "minimumEscrowWindowSeconds"
      ],
      "properties": {
        "tokenDecimals": { "const": 6 },
        "feeBps": { "const": 100 },
        "faucetClaimAmount": { "const": "1000000000" },
        "faucetCooldownSeconds": { "const": 3600 },
        "faucetDailyCap": { "const": "1000000000000" },
        "minimumEscrowWindowSeconds": { "const": 3600 }
      }
    },
    "merchantRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["AMAZON_US", "WALMART_US", "SHOPIFY_UCP"],
      "properties": {
        "AMAZON_US": { "$ref": "#/$defs/merchant" },
        "WALMART_US": { "$ref": "#/$defs/merchant" },
        "SHOPIFY_UCP": { "$ref": "#/$defs/merchant" },
        "GENERIC_WEB_USD": { "$ref": "#/$defs/merchant" }
      }
    },
    "configurationTransactions": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["purpose", "txHash", "block"],
        "properties": {
          "purpose": { "type": "string" },
          "txHash": { "$ref": "#/$defs/hash" },
          "block": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "sourceVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["VitlaneTestUSD", "VitlaneFaucet", "VitlaneSettlement"],
      "properties": {
        "VitlaneTestUSD": { "$ref": "#/$defs/verification" },
        "VitlaneFaucet": { "$ref": "#/$defs/verification" },
        "VitlaneSettlement": { "$ref": "#/$defs/verification" }
      }
    },
    "finality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedFinalizedBlock", "observedFinalizedBlockHash", "observedAt"],
      "properties": {
        "observedFinalizedBlock": { "type": "integer", "minimum": 1 },
        "observedFinalizedBlockHash": { "$ref": "#/$defs/hash" },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["VitlaneTestUSD", "VitlaneFaucet", "VitlaneSettlement"],
      "properties": {
        "VitlaneTestUSD": { "$ref": "#/$defs/contract" },
        "VitlaneFaucet": { "$ref": "#/$defs/contract" },
        "VitlaneSettlement": { "$ref": "#/$defs/contract" }
      }
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "deploymentTxHash",
        "deploymentBlock",
        "runtimeBytecodeHash",
        "sourceVerified",
        "constructorArgs"
      ],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "deploymentTxHash": { "$ref": "#/$defs/hash" },
        "deploymentBlock": { "type": "integer", "minimum": 1 },
        "runtimeBytecodeHash": { "$ref": "#/$defs/hash" },
        "sourceVerified": { "const": true },
        "constructorArgs": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "integer", "boolean"]
          }
        }
      }
    },
    "merchant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalRecipient", "version", "active"],
      "properties": {
        "principalRecipient": { "$ref": "#/$defs/address" },
        "version": { "type": "integer", "minimum": 1 },
        "active": { "const": true }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "url"],
      "properties": {
        "status": { "const": "VERIFIED" },
        "url": { "type": "string", "format": "uri" }
      }
    }
  }
}
