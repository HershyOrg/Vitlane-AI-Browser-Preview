# Server-side only. Never put the model API key in the APK.
MODEL_BASE_URL=https://api.openai.com/v1
# Optional dedicated browser-model credential. When empty, the server uses
# MANAGED_OPENAI_API_SECRET. Neither value belongs in the APK or mobile env.
MODEL_API_KEY=
MANAGED_OPENAI_API_SECRET=
# Set the model identifier provided by your AI service.
MODEL_NAME=
# Native bridge bearer + protocol-v1 command HMAC key. Keep it independent
# from either model API credential. Generate a random value; never commit it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRIDGE_TOKEN=
# Local discovery uses an installed browser because this checkout does not
# include Playwright's bundled Chromium binary.
PLAYWRIGHT_CHANNEL=chrome
HOST=127.0.0.1
PORT=8787
