+        Object queryOrFragmentRaw = page.get("queryOrFragmentPresent");
+        if (!(queryOrFragmentRaw instanceof Boolean) || !pathname.startsWith("/")
+                || pathname.indexOf('?') >= 0 || pathname.indexOf('#') >= 0) {
+            throw new Exception("URL_POLICY_DENIED");
