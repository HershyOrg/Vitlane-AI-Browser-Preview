+            if (parts.length != 4) throw failure("OBSERVATION_INVALID");
+            int[] numbers = new int[4];
+            for (int i = 0; i < 4; i++) {
+                numbers[i] = Integer.parseInt(parts[i]);
+                if (numbers[i] > 255 || !String.valueOf(numbers[i]).equals(parts[i])) throw failure("OBSERVATION_INVALID");
+            }
