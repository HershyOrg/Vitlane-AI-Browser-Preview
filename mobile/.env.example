# Default: direct OpenAI chat, no Vitlane server required.
# Enter your personal API key in the app. Never put keys in EXPO_PUBLIC_*.
EXPO_PUBLIC_VITLANE_DATA_MODE=openai

# The settings below are used only by the optional legacy server mode.
# EXPO_PUBLIC_VITLANE_DATA_MODE=server
EXPO_PUBLIC_VITLANE_API_ORIGIN=
EXPO_PUBLIC_VITLANE_COUNTRY=KR
EXPO_PUBLIC_VITLANE_CITY=Seoul
EXPO_PUBLIC_VITLANE_CURRENCY=KRW
EXPO_PUBLIC_VITLANE_EXECUTION_MODE=LIVE

# Optional server registry key. Empty uses the server's advertised default.
EXPO_PUBLIC_VITLANE_MODEL_KEY=

# Local development only. The server must also have ALLOW_DEV_AUTH=true.
EXPO_PUBLIC_VITLANE_ENABLE_DEV_LOGIN=false
EXPO_PUBLIC_VITLANE_DEV_PROFILE=empty-user
