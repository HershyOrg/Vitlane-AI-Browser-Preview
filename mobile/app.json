{
  "expo": {
    "name": "Vitlane",
    "slug": "vitlane-mobile",
    "scheme": "vitlane",
    "version": "0.8.22",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vitlane.mobile"
    },
    "android": {
      "package": "com.vitlane.mobile",
      "versionCode": 34,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    }
  }
}
