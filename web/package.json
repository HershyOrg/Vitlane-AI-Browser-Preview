    "test:e2e:operator-api-usage": "TMPDIR=/tmp node e2e/operator-api-usage.cjs",
    "test:e2e:support-chat-resize": "TMPDIR=/tmp node e2e/support-chat-resize.cjs",
    "test:e2e:order-process": "TMPDIR=/tmp node e2e/order-process.cjs",
    "test:e2e:operator-order-lookup": "TMPDIR=/tmp node e2e/operator-order-lookup.cjs",
