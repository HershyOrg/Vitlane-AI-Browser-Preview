    "test:e2e:curation-step2-stub": "TMPDIR=/tmp node e2e/curation-step2-stub.cjs",
    "test:e2e:curation-step3": "TMPDIR=/tmp node e2e/curation-step3.cjs",
    "test:e2e:curation-composer-revision": "TMPDIR=/tmp node e2e/curation-composer-revision.cjs",
